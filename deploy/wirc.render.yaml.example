# DRAFT — does not alter the existing Render service or create resources itself.
# Review paid resource plans before applying this as a SEPARATE Blueprint.
# Register/verify domain ownership first; then add wirc.be to the new service.
services:
  - type: web
    name: wirc-agenda
    runtime: python
    region: frankfurt
    plan: starter
    repo: https://github.com/zefyoe/mcq-quiz
    branch: main
    autoDeploy: true
    buildCommand: pip install -r requirements.txt
    startCommand: gunicorn --workers 1 --worker-class gthread --threads 4 --timeout 120 --access-logfile - app:app
    healthCheckPath: /health
    envVars:
      - key: PRACTICE_PROFILE
        value: wirc
      - key: SECRET_KEY
        generateValue: true
      - key: WIRC_DATABASE_URL
        fromDatabase:
          name: wirc-agenda-db
          property: connectionString
      - key: RUN_STARTUP_MIGRATIONS
        value: "1"
      - key: APPOINTMENT_BOOKING_ENABLED
        value: "1"
      - key: PUBLIC_SITE_MODE
        value: active
      - key: APPOINTMENT_PRACTICE_ADDRESS
        value: "Centre Médical Azalys, Lenneke Marelaan 12, 1932 Woluwe-Saint-Étienne"
      - key: GOOGLE_OAUTH_CLIENT_ID
        sync: false
      - key: GOOGLE_OAUTH_CLIENT_SECRET
        sync: false
      - key: GOOGLE_OAUTH_REDIRECT_URI
        value: https://wirc.be/auth/google/callback
databases:
  - name: wirc-agenda-db
    region: frankfurt
    plan: 0.1c-256mb
    diskSizeGB: 5
    storageAutoscalingEnabled: false
    databaseName: wirc_agenda
    ipAllowList: []
